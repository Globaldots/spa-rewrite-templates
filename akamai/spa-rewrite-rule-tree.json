{
  "name": "SPA Template",
  "children": [
    {
      "name": "SPA rewrite",
      "children": [],
      "behaviors": [
        {
          "name": "rewriteUrl",
          "options": {
            "behavior": "REWRITE",
            "targetUrl": "/index.html"
          }
        }
      ],
      "criteria": [
        {
          "name": "fileExtension",
          "options": {
            "matchOperator": "IS_ONE_OF",
            "matchCaseSensitive": false,
            "values": [
              "EMPTY_STRING"
            ]
          }
        }
      ],
      "criteriaMustSatisfy": "all",
      "comments": ""
    }
  ],
  "behaviors": [
    {
      "name": "origin",
      "options": {
        "originType": "CUSTOMER",
        "forwardHostHeader": "ORIGIN_HOSTNAME",
        "cacheKeyHostname": "ORIGIN_HOSTNAME",
        "ipVersion": "IPV4",
        "compress": true,
        "enableTrueClientIp": true,
        "trueClientIpHeader": "True-Client-IP",
        "trueClientIpClientSetting": false,
        "verificationMode": "CUSTOM",
        "originSni": true,
        "httpPort": 80,
        "httpsPort": 443,
        "minTlsVersion": "DYNAMIC",
        "http2Enabled": true,
        "hostname": "${ORIGIN_HOSTNAME}",
        "originCertificate": "",
        "ports": "",
        "tlsVersionTitle": "",
        "http2Title": "",
        "customValidCnValues": [
          "{{Origin Hostname}}",
          "{{Forward Host Header}}"
        ],
        "originCertsToHonor": "STANDARD_CERTIFICATE_AUTHORITIES",
        "standardCertificateAuthorities": [
          "akamai-permissive",
          "THIRD_PARTY_AMAZON"
        ]
      }
    }
  ],
  "criteria": [
    {
      "name": "hostname",
      "options": {
        "matchOperator": "IS_ONE_OF",
        "values": [
          "${PROPERTY_HOSTNAME}"
        ]
      }
    }
  ],
  "criteriaMustSatisfy": "all",
  "comments": ""
}
